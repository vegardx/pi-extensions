{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"files": {
		"includes": ["packages/**/*.ts", "!**/node_modules"]
	}
}
