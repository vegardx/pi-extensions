{
  "name": "pi-ext-dev",
  "private": true,
  "type": "module",
  "description": "Monorepo of pi.dev extensions",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "packages/caffeinate/index.ts",
      "packages/commit/index.ts",
      "packages/derp/index.ts",
      "packages/exa/index.ts",
      "packages/modes/index.ts",
      "packages/prompt-suggestion/index.ts",
      "packages/review/index.ts",
      "packages/session-title/index.ts",
      "packages/startup/index.ts",
      "packages/wrap-up/index.ts"
    ],
    "skills": [
      "packages/*/skills/"
    ]
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit && vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.ts": "biome check --write --no-errors-on-unmatched"
  }
}
